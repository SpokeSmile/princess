# Copy to backend/.env for local use. Never commit your real key.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=25

# Leave empty for local SQLite. On Vercel, set the Neon pooled PostgreSQL URL.
DATABASE_URL=

# Vercel uses production defaults. Set these in the Vercel dashboard.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
# Required in production. Use your own long random secret.
DJANGO_SECRET_KEY=
