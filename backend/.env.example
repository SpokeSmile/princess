# Copy to backend/.env. This file is never sent to the browser.
MISTRAL_API_KEY=
# Example model only. Check that this model is available in your account's Free mode.
# The application makes no automatic switch to another or paid model.
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT=25

# Local development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
# Required when DJANGO_DEBUG=false. Generate your own long random value.
DJANGO_SECRET_KEY=
